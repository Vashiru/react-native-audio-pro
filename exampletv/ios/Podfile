    # if File.exist?(provider_path)
    #   provider_content = File.read(provider_path)

    #   # Replace the literal dictionary @{ ... } with a mutable dictionary that filters out nil values
    #   if provider_content.include?('thirdPartyComponents = @{')
    #     # Find the dictionary block and replace it - need to handle multiline with tabs/newlines
    #     patched_content = provider_content.gsub(
    #       /thirdPartyComponents = @\{.*?\};/m,
    #       'NSMutableDictionary<NSString *, Class<RCTComponentViewProtocol>> *components = [NSMutableDictionary new];

    # Class sliderClass = NSClassFromString(@"RNCSliderComponentView");
    # if (sliderClass) components[@"RNCSlider"] = sliderClass;

    # Class safeAreaProviderClass = NSClassFromString(@"RNCSafeAreaProviderComponentView");
    # if (safeAreaProviderClass) components[@"RNCSafeAreaProvider"] = safeAreaProviderClass;

    # Class safeAreaViewClass = NSClassFromString(@"RNCSafeAreaViewComponentView");
    # if (safeAreaViewClass) components[@"RNCSafeAreaView"] = safeAreaViewClass;

    # thirdPartyComponents = [components copy];'
    #     )

    #     File.write(provider_path, patched_content)
    #     Pod::UI.puts "✅ Patched RCTThirdPartyComponentsProvider.mm to filter out nil Fabric components".green
    #   end
